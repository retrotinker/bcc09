## Redundant STx ... ; LDx ...

# Exclude indexed with pre/post inc/decrement
ST%1	%2,%[X|Y|U|S]3
LD%1	%2,%[X|Y|U|S]3
=
ST%1	%2,%3

# Exclude indexed and immediate completely
ST%1	%![,|#]%2
LD%1	%![,|#]%2
=
ST%1	%2

## LDx followed by STx doesn't change the flags,
## so no nead for a TSTx instruction to follow...

LD%[A|B]1	%2
ST%[A|B]1	%3
TST%[A|B]1
=
LD%1	%2
ST%1	%3

## LDD #0 is the same as CLRA and CLRB, which are a byte shorter (and a
## cycle slower), except that CLRB clears C: so only before an
## instruction that neither reads C nor follows a branch.  (cc1 reads C
## only right after the instruction that sets it; in the tests and libc,
## no C is read after an LDD #0 before something sets it again.)

LDD	#0
%[STD|LDX|LDY|LDU|PSHS|SUBD|ADDD|TFR|JSR]1	%2
=
CLRA
CLRB
%1	%2

## Two LEAS n,S in a row: one, with the sum (the offsets must be numbers:
## copt's arithmetic takes anything else as 0)

LEAS	%![A|B|D]%1,S
LEAS	%![A|B|D]%2,S
=
LEAS	%(%1+%2),S

## TFR X,D then TFR D,X: X and D are already the same (and TFR leaves
## the flags alone)

TFR	X,D
TFR	D,X
=
TFR	X,D

## LEAS 0,S does nothing (the merge above can make it); copt can't
## replace lines with nothing, so this keeps the line after it

LEAS	%(0),S
%1
=
%1
