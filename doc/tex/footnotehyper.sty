% Minimal stand-in for footnotehyper.sty, which some TeX installations lack
% (from the plm09 project, under the MIT license: see tests/sim/LICENSE).
% Pandoc's LaTeX template uses it only to keep footnotes inside tables;
% bcc09's manual has none, so \makesavenoteenv can do nothing.
% Only found when doc/tex is on TEXINPUTS (see doc/mkmanual.sh).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{footnotehyper}[2026/10/23 plm09 stand-in]
\providecommand\makesavenoteenv[1]{}
\endinput
