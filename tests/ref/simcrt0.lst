00001                   ; start-up code for programs run on sim6809: set the stack, clear the
00002                   ; BSS, call main, and exit with the low byte of its result; and routines
00003                   ; for C that use the simulator's I/O block at $FF00 (libc's crt0 and
00004                   ; exit() are for programs with a loader to return to)
00005                   
00006             FF00  io_out	equ	$ff00		; write a character
00007             FF02  io_exit	equ	$ff02		; stop, with this exit status
00008             FF04  io_numh	equ	$ff04		; high byte of a number to print
00009             FF05  io_numl	equ	$ff05		; low byte: print the number
