00001                   ; start-up code for programs run on sim6809: set the stack, clear the
00002                   ; BSS, call main, and exit with the low byte of its result; and routines
00003                   ; for C that use the simulator's I/O block at $FF00
00004                   
00005             FF00  io_out	equ	$ff00		; write a character
00006             FF02  io_exit	equ	$ff02		; stop, with this exit status
00007             FF04  io_numh	equ	$ff04		; high byte of a number to print
00008             FF05  io_numl	equ	$ff05		; low byte: print the number
00009                   
00010 0000              	.data			; the linker defines these in the data segment,
00011                   	import	__edata		; so they must be imported there
00012                   	import	__end
